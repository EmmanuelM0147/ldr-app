# Copy to .env. Do not commit .env.
# Unset DATABASE_URL uses local SQLite (sqlite:///./closer.db).
# Local Postgres from docker-compose.yml. Not a production secret.
DATABASE_URL=postgresql+psycopg://closer:closer@localhost:5432/closer
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_USER=closer
POSTGRES_PASSWORD=closer
POSTGRES_DB=closer
