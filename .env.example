# Copy to .env. Do not commit .env.
# Unset DATABASE_URL uses local SQLite (sqlite:///./closer.db).
# Local Postgres from docker compose. Not a production secret.
DATABASE_URL=postgresql+psycopg://closer:closer@localhost:5433/closer
# Compose sets DATABASE_URL to use the db service hostname instead of localhost.
# On Vercel (or any serverless host): set DATABASE_URL to managed Postgres
# (postgresql+psycopg://…). Or rely on Vercel’s POSTGRES_URL from the Supabase
# integration; the API normalizes it (strips pgbouncer/Prisma query junk).
# SQLite is not suitable there. Run `alembic upgrade head` before first login.
# Required. Min 32 characters. Known placeholders (change-me, etc.) are rejected at boot.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated browser origins allowed to call the API (exact match, include https://).
# Local default:
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173,http://127.0.0.1
# Vercel example (set on the API project; replace with your frontend URL):
# CORS_ORIGINS=https://frontend-kohl-one-76.vercel.app
# Frontend build-time public API base (no trailing slash). Baked into the JS bundle.
VITE_API_URL=http://localhost:8000
# Vercel frontend example (set as a Build env var on the web project, then Redeploy):
# VITE_API_URL=https://backend-lilac-nine-81.vercel.app
MEDIA_ROOT=./media
# Optional. Server-only. Required only when a couple opts into date ideas (GEMINI_* never go to the frontend).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional. Comma-separated. When set, only these emails can register.
REGISTRATION_ALLOWED_EMAILS=
# Frontend origin used when AUTH_RESET_DEBUG builds a reset_url.
PUBLIC_APP_URL=http://localhost:5173
# Local/tests only. When 1, POST /auth/forgot-password may include reset_url in JSON.
# Never enable in production. SMTP email delivery is not wired yet (future).
AUTH_RESET_DEBUG=0
POSTGRES_USER=closer
POSTGRES_PASSWORD=closer
POSTGRES_DB=closer
